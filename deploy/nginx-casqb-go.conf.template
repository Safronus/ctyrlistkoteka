# Nginx config pro qr.casqb.org — brána, aby QR kódy CaSQB ukazovaly ve
# štítku telefonu doménu CaSQB a přitom se počítaly u nás.
#
# Umístění: /etc/nginx/sites-available/casqb-go
# Symlink:  /etc/nginx/sites-enabled/casqb-go
# Po změně: sudo nginx -t && sudo systemctl reload nginx
#
# Předpoklady (v tomhle pořadí):
#   1. DNS u casqb.org:  qr  CNAME  ctyrlistkoteka.cz.   (nebo A na IP VPS)
#      — dělá správce domény casqb.org, u nás nic.
#   2. NASAĎ NEJDŘÍV JEN PRVNÍ (`listen 80`) SERVER BLOK — bez toho
#      druhého. Symlink, `nginx -t`, reload.
#      Proč na dvakrát: blok s `listen 443 ssl` bez certifikátu `nginx -t`
#      odmítne, a certifikát bez tohohle :80 bloku nedostaneš — ostrý
#      default server na :80 posílá na https ÚPLNĚ VŠECHNO včetně
#      `/.well-known/acme-challenge/`, takže challenge skončí 404 na :443
#      (ověřeno 2026-09-22 — první pokus na tohle spadl).
#   3. Certifikát:
#        sudo certbot certonly --webroot -w /var/www/html -d qr.casqb.org
#      `certonly` schválně: `--nginx` by si do configu psal sám a přepsal,
#      co je tady. Pozor, Let's Encrypt chodí i po IPv6 — qr.casqb.org
#      dědí přes CNAME i AAAA, proto jsou tu `listen [::]`.
#   3b. Teprve teď doplň druhý (`listen 443 ssl`) blok, `nginx -t`, reload.
#   4. V /var/www/ctyrlistkoteka/.env:  CASQB_QR_BASE_URL=https://qr.casqb.org
#      a  pm2 reload ctyrlistkoteka  (source /home/app/.nvm/nvm.sh && …).
#
# Host obsluhuje JEN /<token> — šest znaků z abecedy tokenů — a všechno
# ostatní vrací 404. Na tomhle jménu nemá být web, jen skok.
#
# Ověřeno proti nginx 1.28-alpine (stejná řada jako na VPS) s falešným
# backendem: /abc123 → backend dostane /go/abc123; 4 i 7 znaků, kořen,
# /go/… i /wp-admin → 404; :80 → 301 na https; hlavičky včetně
# X-Robots-Tag sedí; ACME challenge se obslouží. Query string se na
# backend nepřenáší (proxy_pass s proměnnou) — redirect si utm_* skládá
# sám, takže na tom nezáleží.
#
# TLS: i bez `options-ssl-nginx.conf` je výchozí nastavení nginx 1.28
# bezpečné — změřeno proti témuž kontejneru: TLS 1.0 i 1.1 odmítnuty,
# projde jen 1.2 (ECDHE-RSA-AES256-GCM-SHA384) a 1.3. Ty dva volitelné
# řádky jsou tedy pohodlí, ne podmínka.

server {
    listen 80;
    listen [::]:80;
    server_name qr.casqb.org;

    location /.well-known/acme-challenge/ {
        root /var/www/html;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    # Moderní zápis: `listen ... http2` je od nginx 1.25 zastaralý a od 1.28
    # na něj `nginx -t` hlásí varování (hlavní config ho ještě má, mění se
    # až spolu s ním, ať se to netestuje dvakrát).
    http2 on;
    server_name qr.casqb.org;

    # SSL. Aktivní, ne zakomentované jako v hlavním configu: ten psal
    # `certbot --nginx` sám, kdežto `certonly` do configu nesahá — kdyby
    # tyhle dva řádky chyběly, `nginx -t` blok s `listen 443 ssl` odmítne.
    ssl_certificate /etc/letsencrypt/live/qr.casqb.org/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/qr.casqb.org/privkey.pem;
    # Doporučené parametry certbota — na VPS ověřeno 2026-09-22, že oba
    # soubory existují. Bez nich by platil výchozí nginx (taky jen TLS 1.2/1.3).
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    server_tokens off;
    # HSTS stejně jako hlavní web. Platí jen pro tohle jméno a jeho
    # případné subdomény — HSTS se dědí směrem DOLŮ, takže na casqb.org
    # ani na jiné subdomény CaSQB to nijak nesahá. Posílá se výhradně přes
    # https (v :80 bloku žádná hlavička není); přes http ho klient podle
    # RFC 6797 stejně musí ignorovat.
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    # Nikdy neindexovat — jsou to skoky, ne stránky.
    add_header X-Robots-Tag "noindex, nofollow, noarchive" always;

    # Stejná ochrana proti floodu jako hlavní web (zóna je v http {} kontextu
    # hlavního configu / nginx.conf).
    limit_req zone=ctyr_main burst=20 nodelay;

    # /<token>  →  aplikace /go/<token>  (token = 6 znaků, viz
    # src/lib/admin/qrToken.ts). Aplikace sken zapíše a přesměruje na cíl.
    location ~ "^/([A-Za-z0-9]{6})$" {
        proxy_pass http://127.0.0.1:3000/go/$1;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Nic jiného tu není.
    location / {
        return 404;
    }
}
