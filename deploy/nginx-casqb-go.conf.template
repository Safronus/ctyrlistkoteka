# Nginx config pro qr.casqb.org — brána, aby QR kódy CaSQB ukazovaly ve
# štítku telefonu doménu CaSQB a přitom se počítaly u nás.
#
# Umístění: /etc/nginx/sites-available/casqb-go
# Symlink:  /etc/nginx/sites-enabled/casqb-go
# Po změně: sudo nginx -t && sudo systemctl reload nginx
#
# Předpoklady (v tomhle pořadí):
#   1. DNS u casqb.org:  qr  CNAME  ctyrlistkoteka.cz.   (nebo A na IP VPS)
#      — dělá správce domény casqb.org, u nás nic.
#   2. Tenhle soubor na VPS, symlink, `nginx -t`, reload.
#   3. Certifikát SI VEZMI DŘÍV, než tenhle soubor nasadíš:
#        sudo certbot certonly --webroot -w /var/www/html -d qr.casqb.org
#      Funguje i bez tohohle configu — hlavní blok na :80 je default server,
#      takže ACME challenge pro qr.casqb.org obslouží z /var/www/html už teď
#      (ověřeno 2026-09-22). `certonly` schválně: `--nginx` by si do configu
#      psal sám a přepsal, co je tady. Bez certifikátu `nginx -t` na bloku
#      s `listen 443 ssl` selže, proto v tomhle pořadí.
#   4. V /var/www/ctyrlistkoteka/.env:  CASQB_QR_BASE_URL=https://qr.casqb.org
#      a  pm2 reload ctyrlistkoteka  (source /home/app/.nvm/nvm.sh && …).
#
# Host obsluhuje JEN /<token> — šest znaků z abecedy tokenů — a všechno
# ostatní vrací 404. Na tomhle jménu nemá být web, jen skok.
#
# Ověřeno proti nginx 1.28-alpine (stejná řada jako na VPS) s falešným
# backendem: /abc123 → backend dostane /go/abc123; 4 i 7 znaků, kořen,
# /go/… i /wp-admin → 404; :80 → 301 na https; hlavičky včetně
# X-Robots-Tag sedí; ACME challenge se obslouží. Query string se na
# backend nepřenáší (proxy_pass s proměnnou) — redirect si utm_* skládá
# sám, takže na tom nezáleží.

server {
    listen 80;
    listen [::]:80;
    server_name qr.casqb.org;

    location /.well-known/acme-challenge/ {
        root /var/www/html;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    # Moderní zápis: `listen ... http2` je od nginx 1.25 zastaralý a od 1.28
    # na něj `nginx -t` hlásí varování (hlavní config ho ještě má, mění se
    # až spolu s ním, ať se to netestuje dvakrát).
    http2 on;
    server_name qr.casqb.org;

    # SSL. Aktivní, ne zakomentované jako v hlavním configu: ten psal
    # `certbot --nginx` sám, kdežto `certonly` do configu nesahá — kdyby
    # tyhle dva řádky chyběly, `nginx -t` blok s `listen 443 ssl` odmítne.
    ssl_certificate /etc/letsencrypt/live/qr.casqb.org/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/qr.casqb.org/privkey.pem;
    # Doporučené parametry certbota. Odkomentuj, POKUD na serveru existují
    # (`ls /etc/letsencrypt/options-ssl-nginx.conf /etc/letsencrypt/ssl-dhparams.pem`)
    # — bez nich platí výchozí nastavení nginx, které je dnes taky TLS 1.2/1.3.
    # include /etc/letsencrypt/options-ssl-nginx.conf;
    # ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    server_tokens off;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    # Nikdy neindexovat — jsou to skoky, ne stránky.
    add_header X-Robots-Tag "noindex, nofollow, noarchive" always;

    # Stejná ochrana proti floodu jako hlavní web (zóna je v http {} kontextu
    # hlavního configu / nginx.conf).
    limit_req zone=ctyr_main burst=20 nodelay;

    # /<token>  →  aplikace /go/<token>  (token = 6 znaků, viz
    # src/lib/admin/qrToken.ts). Aplikace sken zapíše a přesměruje na cíl.
    location ~ "^/([A-Za-z0-9]{6})$" {
        proxy_pass http://127.0.0.1:3000/go/$1;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Nic jiného tu není.
    location / {
        return 404;
    }
}
