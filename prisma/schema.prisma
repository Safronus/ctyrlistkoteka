// Prisma schema pro Čtyřlístkotéka
// Detail viz docs/data-schema.md

// Prisma 7 dropped the Rust query engine: `prisma-client-js` is deprecated
// in favour of `prisma-client`, which needs an explicit output path. Output
// goes to src/generated/prisma (gitignored — regenerated by `prisma
// generate`, which both CI and the VPS deploy already run before build).
generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
}

// Prisma 7 no longer accepts `url` here: the CLI takes the connection
// string from prisma.config.ts, and the runtime client gets it through the
// PrismaPg driver adapter in src/lib/db.ts.
datasource db {
  provider   = "postgresql"
  extensions = [postgis]
}

// ============================================================
//  ENUMS
// ============================================================

enum FindState {
  NORMAL
  ANONYMIZED
  DONATED
  LOST
  NO_GPS
  NO_PHOTO
  LOCATION_MISSING // nález není přiřazen k žádné lokalitě (BEZLOKACE)
  LOCATION_GONE // lokalita existovala, ale fyzicky zanikla (LOKACE-NEEXISTUJE) — kód lokality má prefix "NEEXISTUJE-"
  NOT_PICKED
  GIGANT // čtyřlístek mimořádně velkých rozměrů — kosmetický stav nesený přes LokaceStavyPoznamky.json (stavy.GIGANT)
}

enum ImageType {
  ORIGINAL
  CROP
}

/// Where one in-the-wild card is on its journey. FOUND is set automatically
/// by the first scan of its landing page; the rest are ticked by hand.
enum DropStatus {
  PREPARED // číslo vyhrazeno, nic vytištěno
  PRINTED // kartička vytištěná, doma
  HIDDEN // schovaná v terénu
  FOUND // někdo naskenoval QR
}

// ============================================================
//  LOCATIONS
// ============================================================

model Location {
  id                 Int     @id // MAP_ID z názvu souboru lokační mapy (shoduje se s klíči v LokaceStavyPoznamky.json "lokace")
  code               String  @unique @db.VarChar(150) // "RATIBOŘ_POLE001f", "HLUBOKÁ NAD VLTAVOU_GOLFCLUB001", "NEEXISTUJE-ZLÍN_JSVAHY-JAVOROVÁ002"
  codeTransliterated String  @map("code_transliterated") @db.VarChar(150) // ASCII-safe forma z toAsciiCode() — convenience, ne přirozený klíč
  cadastralArea      String  @map("cadastral_area") @db.VarChar(100) // "RATIBOŘ"; fallback = celý code
  locationType       String? @map("location_type") @db.VarChar(100) // "POLE", "JSVAHY-UTB-U5-Z" — může chybět pro HOŠŤÁLKOVÁ001
  number             Int?    @db.SmallInt // 000–999, může být null pro RATIBOŘ_DOMA-JALOVEC
  subpart            String? @db.Char(1) // "a", "f", …
  displayName        String  @map("display_name") @db.VarChar(500) // z popisu mapy (může být dlouhý)
  description        String? @db.Text

  // PostGIS geometry (raw SQL pro čtení/zápis)
  centerPoint Unsupported("geometry(Point, 4326)")?   @map("center_point")
  polygon     Unsupported("geometry(Polygon, 4326)")?

  // Optional 2-level hierarchy. Subparts of a master location (e.g. the
  // 7 fragments of RATIBOŘ_POLE001 shown as 001a..001g) declare their
  // parent through data/meta/LokaceHierarchie.json — the subpart letter
  // ALONE isn't a reliable hierarchy signal because some 001a/001b pairs
  // are peers, not children. Max depth 2 is enforced by the sync script.
  parentId Int?       @map("parent_id")
  parent   Location?  @relation("LocationParent", fields: [parentId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  children Location[] @relation("LocationParent")

  // For child locations only: when true their polygon overlays the
  // parent on /mapa by default (no sidebar opt-in needed). Driven by
  // the `{ "code": ..., "map": true }` form in LokaceHierarchie.json;
  // sync sets it. Always false for top-level locations (they're shown
  // regardless). See docs/admin-overview.md.
  showOnMapByDefault Boolean @default(false) @map("show_on_map_by_default")

  // --- Location-map v2 fields (nullable; back-filled from the map package
  // manifest, see docs/filename-convention.md + project migration). All
  // nullable so v1 rows keep working until a location is re-synced from a
  // v2 package. Read paths fall back to the v1 source when these are null. ---
  //
  // Which data generation this location was last synced from: 1 = v1
  // (code/GPS/zoom parsed from the map filename), 2 = v2 (from manifest.json).
  // Lets read paths pick the v2 source only where it actually exists.
  schemaVersion Int?    @map("schema_version") @db.SmallInt
  // ISO-3166 alpha-2 country code (CZ, SK, JP…) straight from the manifest.
  // Replaces the run-time countryFromCoords() point-in-polygon on center_point
  // — faster and exact at borders (the Štúrovo case). Fallback stays for nulls.
  countryCode   String? @map("country_code") @db.VarChar(2)
  // Human-readable reverse-geocoded address ("Svěrákova 161"), used as a nicer
  // display name when the map's popis is the empty "BezPoznámky" marker.
  geoAddress    String? @map("geo_address") @db.VarChar(255)
  // Location indicator kind: "dot" (point, no radius), "radius" (point with
  // radius_m) or "polygon" (AOI). Drives which shape the map/stats draw and
  // how area is computed. Mutually exclusive — see the map generator.
  indicator     String? @db.VarChar(16)
  // Radius in metres; set only for indicator = "radius" (null for dot and
  // polygon). Area of a radius location = π·radius². A dot has no area.
  radiusM       Float?  @map("radius_m")
  // Precomputed area in m²: polygon → real AOI area, radius → π·radius².
  // From the manifest so we don't recompute ST_Area at run time, and so
  // radius locations (no polygon) still contribute an area to density stats.
  aoiAreaM2     Float?  @map("aoi_area_m2")
  // Cancelled/defunct location flag from v2 metadata. Replaces the v1
  // convention of a "NEEXISTUJE-" prefix on the code; read path switches to
  // this in phase D, keeping the prefix check as a fallback while both exist.
  isCancelled   Boolean @default(false) @map("is_cancelled")

  // Terrain elevation of the centre point, metres above sea level. NOT from
  // the photos: phone GPS altitude scatters by metres to tens of metres (see
  // docs/gotchas.md), so this comes from a digital elevation model, filled by
  // the one-off `scripts/fetch-elevations.ts`. Deliberately absent from the
  // sync upsert so a re-sync never clears it. Null = never looked up, or an
  // anonymized location (their coordinates are never sent anywhere).
  altitudeM      Float?  @map("altitude_m")
  // Which model the value came from ("eudem25m", "srtm30m", …) — kept so a
  // later, better source can be told apart from an older reading.
  altitudeSource String? @map("altitude_source") @db.VarChar(32)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  maps  LocationMap[]
  finds Find[]

  @@index([cadastralArea])
  @@index([locationType])
  @@index([parentId])
  @@map("locations")
}

// ============================================================
//  LOCATION MAPS (PNG/JPEG lokační mapy)
// ============================================================

model LocationMap {
  id         Int      @id // MAP_ID z názvu souboru (1–99999)
  locationId Int      @map("location_id")
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  locationCode String  @map("location_code") @db.VarChar(150) // pro rychlé propojení
  description  String? @db.VarChar(500) // lidsky čitelný popis z názvu
  centerLat    Float   @map("center_lat") // GPS střed z názvu
  centerLng    Float   @map("center_lng")
  zoom         Int     @db.SmallInt // OSM zoom level
  // v2: the image is rendered at render_zoom (≥ zoom), so image_bounds must be
  // computed from render_zoom + output dimensions, not zoom (which would put
  // the overlay at the wrong scale). Nullable — null means a v1 map whose
  // bounds came from `zoom`. See docs/filename-convention.md.
  renderZoom   Int?    @map("render_zoom") @db.SmallInt

  imagePath   String @map("image_path") @db.VarChar(500) // cesta k souboru na disku
  imageBounds Json?  @map("image_bounds") // [[swLat, swLng], [neLat, neLng]]
  imageWidth  Int?   @map("image_width") // rozměry obrázku v px
  imageHeight Int?   @map("image_height")

  hasPolygon       Boolean @default(false) @map("has_polygon") // AOI_POLYGON v metadatech
  isAnonymized     Boolean @default(false) @map("is_anonymized") // z metadat souboru
  originalFilename String  @map("original_filename") @db.VarChar(500)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  finds Find[]

  @@index([locationId])
  @@index([locationCode])
  @@map("location_maps")
}

// ============================================================
//  FINDS
// ============================================================

model Find {
  id         Int          @id // ID z názvu souboru, NE autoincrement
  locationId Int?         @map("location_id")
  location   Location?    @relation(fields: [locationId], references: [id], onDelete: SetNull)
  mapId      Int?         @map("map_id")
  map        LocationMap? @relation(fields: [mapId], references: [id], onDelete: SetNull)

  foundAt      DateTime? @map("found_at") @db.Timestamptz(6) // z EXIF DateTimeOriginal, plný timestamp včetně H:M:S
  leafCount    Int       @default(4) @map("leaf_count") @db.SmallInt
  notes        String?   @db.Text // z JSON poznamky
  isAnonymized Boolean   @default(false) @map("is_anonymized") // z JSON anonymizace + filename

  // Denormalized vote count — cache pro O(1) výpis/žebříček. Sync přes
  // trigger v migraci (insert/delete na find_votes ↦ +1/-1 zde). Bez
  // tohoto sloupce by Top 10 muselo na každý request groupovat všech
  // ~17 k findů.
  voteCount Int @default(0) @map("vote_count")

  /// Optional per-find unlock code for anonymized donation photos.
  /// NULL means the find inherits the global FIND_PHOTO_UNLOCK_CODE
  /// env var; a non-null value overrides that secret for THIS find
  /// only — recipients of one gift get a personal code while the
  /// rest of the collection stays on the shared default. Set / cleared
  /// from /admin/files/donation-photos/<filename>.
  unlockCode String? @map("unlock_code") @db.VarChar(256)

  coordinates Unsupported("geometry(Point, 4326)")?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  images   FindImage[]
  states   FindStateAssignment[]
  votes    FindVote[]
  qrCode   FindQrCode?
  qrScans  FindQrScan[]
  dropItem DropItem?

  @@index([locationId])
  @@index([mapId])
  @@index([foundAt(sort: Desc)])
  @@index([leafCount])
  @@index([isAnonymized])
  @@index([voteCount(sort: Desc)])
  @@map("finds")
}

// ============================================================
//  FIND VOTES (veřejné hlasování „palec nahoru")
// ============================================================
//
// Každý hlas má dvě nezávislé identity:
//   - voterUuid     — UUID v httpOnly cookie (1 rok)
//   - fingerprint   — sha1(ip + ua + accept-lang + serverový salt)
// Dvě unique constraints zajistí, že OBĚ se musí lišit, aby šel nový
// hlas pro stejný nález. To zvládne casual cheating; útočník musí
// vymazat cookies *a* změnit IP/UA, aby tutéž věc lajknul podruhé.
//
// Pro RŮZNÉ nálezy stejná osoba hlasuje libovolně — to není potřeba
// chránit (dle zadání).
//
// `ipHash` a `userAgent` jsou jen pro audit + admin reverze (smazat
// hlasy z konkrétní IP/UUID). Plný IP nikdy neukládáme; sha1 +
// serverový salt → nelze přímo dohledat osobu z DB dumpu.

model FindVote {
  findId      Int      @map("find_id")
  find        Find     @relation(fields: [findId], references: [id], onDelete: Cascade)
  voterUuid   String   @map("voter_uuid") @db.Uuid // z cookie
  fingerprint String   @map("fingerprint") @db.Char(40) // sha1
  votedAt     DateTime @default(now()) @map("voted_at") @db.Timestamptz
  ipHash      String   @map("ip_hash") @db.Char(40) // audit-only, sha1
  userAgent   String?  @map("user_agent") @db.VarChar(500) // audit-only

  @@id([findId, voterUuid])
  // `map:` pins the DB index name to what migration 20260523 actually
  // created. Prisma 6's `name:` also drove the DB name; Prisma 7 splits them
  // (name = Client API, map = DB), so without map: v7 wants to rename the
  // live index to its default — an unrelated churn we don't want.
  @@unique([findId, fingerprint], name: "find_votes_fingerprint_unique", map: "find_votes_fingerprint_unique")
  @@index([votedAt(sort: Desc)])
  @@index([fingerprint])
  @@index([voterUuid])
  @@map("find_votes")
}

// ============================================================
//  FIND IMAGES
// ============================================================

model FindImage {
  id     Int  @id @default(autoincrement())
  findId Int  @map("find_id")
  find   Find @relation(fields: [findId], references: [id], onDelete: Cascade)

  imageType        ImageType @default(ORIGINAL) @map("image_type") // ORIGINAL nebo CROP
  originalFilename String    @map("original_filename") @db.VarChar(500)
  originalSha1     String    @map("original_sha1") @db.Char(40) // pro detekci změn
  webPath          String    @map("web_path") @db.VarChar(500) // /generated/web/{sha}.webp
  thumbPath        String    @map("thumb_path") @db.VarChar(500) // /generated/thumb/{sha}.webp

  width     Int
  height    Int
  isPrimary Boolean @default(false) @map("is_primary")
  sortOrder Int     @default(0) @map("sort_order") @db.SmallInt

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([findId])
  @@index([isPrimary])
  @@map("find_images")
}

// ============================================================
//  FIND STATE ASSIGNMENTS (M:N)
// ============================================================

model FindStateAssignment {
  findId Int       @map("find_id")
  find   Find      @relation(fields: [findId], references: [id], onDelete: Cascade)
  state  FindState

  @@id([findId, state])
  @@index([state])
  @@map("find_state_assignments")
}

// ============================================================
//  QR CODES (admin-generated links to the public site)
// ============================================================
//  Each generated QR gets a short `token`; the /go/<token> redirect
//  resolves it — logs a QrScan and 302s to the chosen public page.
//  Render options are stored so the same QR re-downloads identically.
//  Retiring a physical QR sets `archivedAt` ("Zničený"): the redirect
//  keeps working for stray scans and the scan history is preserved.

model QrCode {
  id           Int       @id @default(autoincrement())
  /// Short unique slug encoded in the QR (the /go/<token> path).
  token        String    @unique @db.VarChar(16)
  /// Human label for the evidence list (e.g. where it's stuck).
  label        String    @db.VarChar(200)
  /// Target public page key: home | sbirka | lokality | mapa | statistiky
  target       String    @db.VarChar(20)
  /// Locale the QR links to: cs | en
  locale       String    @default("cs") @db.VarChar(5)
  // render options (stored so re-download reproduces the same image)
  theme        String    @default("brand") @db.VarChar(16)
  moduleStyle  String    @default("clover") @map("module_style") @db.VarChar(16)
  centerImage  String    @default("clover") @map("center_image") @db.VarChar(16)
  centerScale  String    @default("md") @map("center_scale") @db.VarChar(8)
  showTitle    Boolean   @default(true) @map("show_title")
  titleText    String?   @map("title_text") @db.VarChar(200)
  showCaption  Boolean   @default(false) @map("show_caption")
  size         String    @default("md") @db.VarChar(8)
  border       String    @default("none") @db.VarChar(12) // none | frame | panel | cut
  borderRadius String    @default("soft") @map("border_radius") @db.VarChar(8) // soft | round
  borderColor  String    @default("theme") @map("border_color") @db.VarChar(8) // theme | gray
  /// Module density = error-correction level under a friendlier name:
  /// dense (H) | medium (Q) | compact (M). See QrDensity in lib/admin/qr.ts.
  density      String    @default("dense") @db.VarChar(8)
  /// Set when the physical QR is retired ("Zničený"). Redirect still works.
  archivedAt   DateTime? @map("archived_at") @db.Timestamptz
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz

  scans QrScan[]

  @@index([archivedAt])
  @@map("qr_codes")
}

/// Admin-side bookkeeping for one find's QR code.
///
/// Find QR codes need no minting — the encoded URL is always
/// `/n/<find id>`, so every find implicitly "has" a code and this table
/// is purely about the admin view. A row exists when the find is pinned
/// into the list (donated finds are listed from their state and need no
/// row) and/or when its code has been revoked.
model FindQrCode {
  findId Int  @id @map("find_id")
  find   Find @relation(fields: [findId], references: [id], onDelete: Cascade)

  /// Show this find in the list even though it isn't donated.
  pinned Boolean @default(true)

  /// Set when the operator cancels the code. The printed card keeps
  /// working — `/n/<id>` still redirects to the find detail, because a
  /// card already in someone's hands must never dead-end — but the scan
  /// stops being logged and the row moves to the "Zrušené" section.
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([revokedAt])
  @@map("find_qr_codes")
}

/// One logged scan of a find QR code (a hit on /n/<find id>).
///
/// Separate table from `qr_scans` because find codes have no `qr_codes`
/// row to hang off — the find id IS the identity. Timestamp only, same
/// no-PII rule as page QR scans.
model FindQrScan {
  id        Int      @id @default(autoincrement())
  findId    Int      @map("find_id")
  find      Find     @relation(fields: [findId], references: [id], onDelete: Cascade)
  /// Timestamp only — no IP / UA / PII is stored for scans.
  scannedAt DateTime @default(now()) @map("scanned_at") @db.Timestamptz

  @@index([findId])
  @@index([scannedAt])
  @@map("find_qr_scans")
}

model QrScan {
  id        Int      @id @default(autoincrement())
  qrCodeId  Int      @map("qr_code_id")
  qrCode    QrCode   @relation(fields: [qrCodeId], references: [id], onDelete: Cascade)
  /// Timestamp only — no IP / UA / PII is stored for scans.
  scannedAt DateTime @default(now()) @map("scanned_at") @db.Timestamptz

  @@index([qrCodeId])
  @@index([scannedAt])
  @@map("qr_scans")
}

// ============================================================
//  DROP CAMPAIGNS ("darování ve světě")
// ============================================================
//
//  A wave of four-leaf clovers laminated onto cards and hidden around
//  real places for strangers to find. Scanning a card's QR opens
//  `/d/<token>` — a per-card landing page, never linked from the site and
//  never in the sitemap, which logs the scan and offers two ways on: the
//  find's own detail page, or the homepage.
//
//  Three levels because a wave spans several towns and more waves are
//  planned: campaign (shared philosophy + default texts) → area (one map,
//  one centre) → item (one physical card).
//
//  Every text on an item is nullable: null means "inherit the campaign's
//  default", so re-wording the campaign propagates everywhere that hasn't
//  been overridden.

model DropCampaign {
  id   Int     @id @default(autoincrement())
  name String  @db.VarChar(120)
  /// Admin-facing note: what this wave is about, how many pieces, why.
  note String? @db.Text

  /// Landing-page defaults. CS is required, EN optional — the page falls
  /// back to CS when a visitor's English text is missing.
  headingCs  String    @map("heading_cs") @db.VarChar(200)
  headingEn  String?   @map("heading_en") @db.VarChar(200)
  bodyCs     String    @map("body_cs") @db.Text
  bodyEn     String?   @map("body_en") @db.Text
  /// Secondary "bonus" block rendered under the main text.
  bonusCs    String?   @map("bonus_cs") @db.Text
  bonusEn    String?   @map("bonus_en") @db.Text
  /// Default title printed above the QR, and the default render options
  /// (same option bag as the rest of the QR admin).
  qrTitle    String?   @map("qr_title") @db.VarChar(200)
  /// Default line printed UNDER the code. Empty means no line at all —
  /// the card is then simply shorter.
  qrCaption  String?   @map("qr_caption") @db.VarChar(200)
  qrOptions  Json?     @map("qr_options")

  /// Default hunt hint for the whole wave — "hledej u laviček v parku".
  /// A card overrides it with something specific to where it actually
  /// sits; publishing stays a per-card decision (`hintPublished`).
  hintCs     String?   @map("hint_cs") @db.Text
  hintEn     String?   @map("hint_en") @db.Text

  // --- Google Sheets the wave is filled in through -----------------
  //
  // The link is READ access to every hiding coordinate in the wave, so
  // it is admin-only data: never rendered on a public route, never in a
  // response the landing page can reach.

  /// Sheet the crew edits. Null = the wave is managed in the admin only.
  sheetUrl       String?   @map("sheet_url") @db.VarChar(500)
  /// Whether the crew page (`/tym/<token>`) may show a link to that sheet.
  ///
  /// OFF by default and deliberately its own switch: CLAUDE.md §9 makes the
  /// sheet URL admin-only data, because the sheet carries EVERY area's
  /// coordinates and is usually shared for editing — strictly more than one
  /// area's crew map gives away. The owner can hand it to the crew anyway
  /// (2026-08-12), but it has to be a decision, not a side effect of turning
  /// the crew map on.
  sheetShareCrew Boolean   @default(false) @map("sheet_share_crew")
  /// When on, the sheet is the source of truth for the cards' fields.
  sheetMode      Boolean   @default(false) @map("sheet_mode")
  /// Fingerprint of the last workbook fetched, so an unchanged sheet
  /// costs nothing to check.
  sheetHash      String?   @map("sheet_hash") @db.VarChar(64)
  /// Last time a fetch succeeded, and last time the content differed.
  sheetSyncedAt  DateTime? @map("sheet_synced_at") @db.Timestamptz
  sheetChangedAt DateTime? @map("sheet_changed_at") @db.Timestamptz
  /// Last hard failure (unreachable, missing key column…), for the panel.
  sheetError     String?   @map("sheet_error") @db.Text

  /// The campaign defaults as they stood when the workbook was last
  /// exported. Lets the sync tell "the crew typed this" from "this is a
  /// superseded default the sheet still carries" — see docs.
  exportedDefaults Json?     @map("exported_defaults")
  exportedAt       DateTime? @map("exported_at") @db.Timestamptz

  /// Who can be assigned to hide a card — the crew for this wave. A plain
  /// array rather than a table: it is a short list of names the operator
  /// edits by hand, it changes per wave, and a typo should be fixable
  /// without a migration. `DropItem.placedBy` holds the chosen name.
  placers String[] @default([])

  // --- Collage background on the landing page ----------------------
  //
  // Built from the collection's own crops by `pnpm collage`; see
  // src/lib/collage.ts for the variants and how a card is assigned one.
  // Plain strings rather than Postgres enums: adding a variant should be
  // a code change, not a migration, and an unknown value degrades to no
  // background rather than a 500.
  /// OFF | FIXED | BY_FIND | RANDOM | DAILY
  bgMode    String @default("OFF") @map("bg_mode") @db.VarChar(16)
  /// Which collage, when bgMode = FIXED.
  bgVariant String @default("MOSAIC") @map("bg_variant") @db.VarChar(16)
  /// How strongly it shows behind the text, 0–100 %. The header always
  /// shows the collage at full strength; this is the veil below it.
  bgOpacity Int    @default(35) @map("bg_opacity") @db.SmallInt
  /// How opaque the text card itself is, 0–100 %. 100 = the original
  /// solid white. Below that the collage shows THROUGH the card, which is
  /// the only way a shaped background is visible on a phone — there the
  /// card is nearly the whole screen, so anything merely behind it is a
  /// rumour. A blur comes with it so the text stays readable.
  bgCardOpacity Int @default(100) @map("bg_card_opacity") @db.SmallInt
  /// MOSAIC | SCATTER | OFF — what a phone gets, whatever `bgMode` picks
  /// for the desktop. Shapes are excluded on purpose; see
  /// COLLAGE_MOBILE_CHOICES in src/lib/collage.ts.
  bgMobileVariant String @default("BY_FIND") @map("bg_mobile_variant") @db.VarChar(16)

  /// While true, `/d/<token>` still renders but no scan is recorded and no
  /// card flips to FOUND. For testing the cards, and for the stretch
  /// between printing them and actually leaving them somewhere — without
  /// it, the first hundred scans of a wave are the crew's own.
  scansPaused Boolean @default(false) @map("scans_paused")

  archivedAt DateTime? @map("archived_at") @db.Timestamptz
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  areas DropArea[]
  items DropItem[]

  @@map("drop_campaigns")
}

model DropArea {
  id         Int          @id @default(autoincrement())
  campaignId Int          @map("campaign_id")
  campaign   DropCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  name           String @db.VarChar(120)
  /// Map centre + zoom for this area's admin map.
  centerLat      Float  @map("center_lat")
  centerLng      Float  @map("center_lng")
  zoom           Int    @default(14) @db.SmallInt
  /// Radius in metres used by "scatter the unplaced pieces at random".
  /// Only a fallback once `boundary` is set — a town is not a circle.
  scatterRadiusM Float? @map("scatter_radius_m")

  /// The town's real outline, fetched once from OSM (Nominatim) and kept
  /// here so nothing calls out again. Plain GeoJSON Polygon/MultiPolygon
  /// in a Json column rather than PostGIS: it is drawn on an admin map
  /// and point-tested in JS, never queried spatially.
  boundary       Json?   @map("boundary")
  /// What OSM called the thing we took the outline from, so the operator
  /// can tell "Zlín the town" from "Zlín the district".
  boundaryLabel  String? @map("boundary_label") @db.VarChar(300)

  // --- Read-only map for the crew ---------------------------------
  //
  // An unlisted page showing this area's hiding spots so the team can
  // check them on a map instead of squinting at GPS in a spreadsheet.
  // It carries EVERY hiding coordinate, so it is gated twice: an
  // unguessable token AND a password, both set in the admin. The owner
  // accepted that risk knowingly (2026-08-11) on the same terms as the
  // shared Google Sheet — the password is what keeps a forwarded link
  // from being enough on its own.
  /// Off by default: a wave is a scatter of unrelated cards unless the
  /// operator deliberately strings some of them together. Turning it off
  /// hides the chain from every landing page at once without losing the
  /// order that was built.
  chainEnabled Boolean @default(false) @map("chain_enabled")

  /// Null until the operator turns the crew map on.
  crewToken    String? @unique @map("crew_token") @db.VarChar(64)
  /// Plain text on purpose: it is a shared word for a group chat, not a
  /// login. Never reused elsewhere, and the page is noindex + out of the
  /// sitemap. Hashing it would only pretend it is a credential.
  crewPassword String? @map("crew_password") @db.VarChar(120)

  sortOrder Int      @default(0) @map("sort_order") @db.SmallInt
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  items DropItem[]

  @@index([campaignId])
  @@map("drop_areas")
}

model DropItem {
  id         Int          @id @default(autoincrement())
  campaignId Int          @map("campaign_id")
  campaign   DropCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  areaId     Int?         @map("area_id")
  area       DropArea?    @relation(fields: [areaId], references: [id], onDelete: SetNull)

  /// The find this card carries. Unique — one physical clover, one find.
  /// Required: the landing page's primary button opens its detail.
  findId Int  @unique @map("find_id")
  find   Find @relation(fields: [findId], references: [id], onDelete: Cascade)

  /// Random, unguessable path segment of the landing page (`/d/<token>`).
  /// A UUID: at the 4 cm the cards are printed at, the denser QR still
  /// gives ~0.9 mm modules, comfortably readable.
  token String @unique @db.VarChar(64)

  status DropStatus @default(PREPARED)

  /// Where the card is hidden. Plain floats rather than PostGIS: these are
  /// only ever drawn as markers on an admin map, never queried spatially,
  /// and floats keep the whole CRUD in plain Prisma. NEVER exposed
  /// publicly — see docs/admin-overview.md.
  lat Float?
  lng Float?

  /// Per-item overrides. Null = inherit the campaign's value.
  headingCs String? @map("heading_cs") @db.VarChar(200)
  headingEn String? @map("heading_en") @db.VarChar(200)
  bodyCs    String? @map("body_cs") @db.Text
  bodyEn    String? @map("body_en") @db.Text
  bonusCs   String? @map("bonus_cs") @db.Text
  bonusEn   String? @map("bonus_en") @db.Text
  qrTitle   String? @map("qr_title") @db.VarChar(200)
  qrCaption String? @map("qr_caption") @db.VarChar(200)
  qrOptions Json?   @map("qr_options")
  /// Landing image for this one card, relative to the generated dir.
  imagePath String? @map("image_path") @db.VarChar(500)

  /// Optional hunt hint. Shown on the find's PUBLIC detail page only when
  /// `hintPublished` is on; the landing page then points visitors at it.
  /// Free text written by the operator — it must not spell out the GPS.
  hintCs        String? @map("hint_cs") @db.Text
  hintEn        String? @map("hint_en") @db.Text
  hintPublished Boolean @default(false) @map("hint_published")

  /// The crew's own note about this card — typically WHERE it goes:
  /// "u lavičky za knihovnou", "vezme Míša cestou z práce". Filled in the
  /// shared sheet and shown on the card in the admin. Never public: it
  /// describes a hiding place as plainly as the coordinates do.
  teamNote String? @map("team_note") @db.Text

  /// Crew member who is to hide (or has hidden) this card. Free text so an
  /// import can carry a name the roster doesn't know yet; the admin offers
  /// the campaign's roster as a dropdown and flags anything outside it.
  placedBy String? @map("placed_by") @db.VarChar(120)

  placedAt DateTime? @map("placed_at") @db.Timestamptz
  /// First scan, i.e. when somebody found it. Set once, by the landing page.
  foundAt  DateTime? @map("found_at") @db.Timestamptz

  /// Position in this area's "řetězec čtyřlístků" — the hunt where each
  /// card's landing page reveals a hint towards the next one. Null (the
  /// default) means the card is simply not in the chain: it is a SUBSET of
  /// an area, chosen in the admin. Numbers are 1..N and dense within an
  /// area; the chain ends at the highest one, it does not wrap.
  ///
  /// Deliberately an order rather than a `nextItemId` link: reshuffling is
  /// then a rewrite of N small integers instead of a linked list that can
  /// grow a cycle or a fork, and "who comes after me" is one indexed query.
  chainOrder Int? @map("chain_order") @db.SmallInt

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  scans DropScan[]

  @@index([campaignId])
  @@index([areaId])
  @@index([status])
  @@index([areaId, chainOrder])
  @@map("drop_items")
}

model DropScan {
  id        Int      @id @default(autoincrement())
  itemId    Int      @map("item_id")
  item      DropItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  /// Timestamp only — no IP / UA / PII, same rule as the other scan logs.
  scannedAt DateTime @default(now()) @map("scanned_at") @db.Timestamptz

  @@index([itemId])
  @@index([scannedAt])
  @@map("drop_scans")
}
